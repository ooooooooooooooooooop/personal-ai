#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# shellcheck source=.githooks/_python.sh
source "$ROOT/.githooks/_python.sh"

# The enforcer must be the enforced. This hook judges already-committed history
# while executing scripts from the working tree, so enforcement code that
# differs from HEAD has never been tested against the commits being pushed.
"$PY" scripts/governance/enforcement_sync_guard.py --baseline head

"$PY" scripts/governance/canonical_writer.py pre-push "$@"

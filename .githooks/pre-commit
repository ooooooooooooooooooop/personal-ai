#!/usr/bin/env bash
# Pre-commit gate for the agent-tooling repository — snapshot edition.
#
# Install once per clone:
#   git config core.hooksPath .githooks
#
# The gate freezes the staged index into an immutable candidate tree
# (`git write-tree`), materializes it into a temp dir, and runs every
# check against THAT snapshot — never against the live index or working
# tree. The plan comes from scripts/gate_planner.py inside the snapshot;
# a tiny bootstrap classifier below (stable, embedded, not candidate
# code) forces FULL when the change touches gate machinery, so a
# candidate planner can never decide its own admission. The hook ends by
# re-verifying HEAD and the index: if either moved during the checks the
# commit is rejected — under a shared index there is no way to hold the
# index atomically from hook-start to commit-creation, so we detect and
# fail instead of certifying a diff we never saw.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Git exports GIT_INDEX_FILE (relative ".git/index") into hook env; any child
# git process running inside ANOTHER repo/worktree (e.g. the workspace
# isolation tests) resolves it against that repo and fails with
# ".git/index.lock: No such file or directory". Clear repo-scoping vars so
# test/git subprocesses are hermetic.
unset GIT_INDEX_FILE GIT_PREFIX GIT_DIR GIT_WORK_TREE \
  GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES \
  GIT_COMMON_DIR GIT_NAMESPACE 2>/dev/null || true

PY="${PYTHON:-python3}"
"$PY" -c '' >/dev/null 2>&1 || PY=python

step() { printf '\n== %s ==\n' "$1"; }
fail() { printf '\npre-commit gate: FAIL — %s\n' "$1" >&2; exit 1; }

step "canonical writer ownership"
"$PY" scripts/governance/canonical_writer.py pre-commit

step "freeze candidate snapshot"
BASE_OID="$(git rev-parse HEAD)"
TREE_OID="$(git write-tree)" || fail "index locked — retry"
# Materialize the candidate as a real git repo: an ephemeral commit on
# top of the frozen tree, cloned locally (hardlinked object db) and
# checked out detached. Tests that exercise git mechanics (clone,
# ls-files, oid resolution) see exactly the candidate state; the
# stripped origin makes accidental pushes fail-closed.
SNAP_OID="$(git commit-tree "$TREE_OID" -m 'gate candidate snapshot')"
CAND="$(mktemp -d)/cand"
trap 'rm -rf "$CAND"' EXIT
git clone --local --quiet --no-checkout "$ROOT" "$CAND"
git -C "$CAND" remote remove origin
git -C "$CAND" checkout --quiet --detach "$SNAP_OID"
echo "base=$BASE_OID"
echo "tree=$TREE_OID"
echo "snap=$SNAP_OID"

step "bootstrap trigger scan"
# Stable classifier: the FULL/DELTA decision for gate-machinery paths is
# made HERE (frozen diff, fixed prefix list) — the candidate planner
# only enumerates task sets, it cannot downgrade its own gate.
FORCE_FLAG="$("$PY" - "$BASE_OID" "$TREE_OID" <<'PYEOF'
import subprocess, sys
TRIG = (
    ".githooks/", ".github/workflows/",
    "scripts/gate_planner.py", "scripts/validate_repo.py",
    "scripts/governance/", "scripts/publish_check.py",
    "scripts/run_skill_evals.py", "scripts/sync_skills.py",
    "skills/skill-quality-gate/",
    "skills.json", "mcp.json", "pyproject.toml",
    "package.json", "package-lock.json", "requirements",
)
out = subprocess.run(
    ["git", "diff", "--name-status", "-z", sys.argv[1], sys.argv[2]],
    capture_output=True, text=True, check=True).stdout
paths = []
for tok in out.split("\0"):
    if not tok:
        continue
    paths.append(tok.split("\t", 1)[1] if "\t" in tok else tok)
print("--force-full" if any(
    p.startswith(t) for p in paths for t in TRIG) else "")
PYEOF
)"

step "impact plan"
# The planner runs FROM the snapshot: it evaluates the code being
# committed, on the frozen BASE..TREE diff, reading git objects from
# the snapshot clone's own object db (hardlinked, read-only usage).
PLAN_JSON="$("$PY" "$CAND/scripts/gate_planner.py" \
  --repo "$CAND" --base "$BASE_OID" --tree "$TREE_OID" \
  --src "$CAND" $FORCE_FLAG)"
echo "$PLAN_JSON"
field() { printf '%s' "$PLAN_JSON" | "$PY" -c '
import json, sys
for item in json.load(sys.stdin)[sys.argv[1]]:
    print(item)' "$1" | tr -d '\r'; }
MODE="$(printf '%s' "$PLAN_JSON" | "$PY" -c 'import json,sys; print(json.load(sys.stdin)["mode"])' | tr -d '\r')"

step "whitespace check (git diff --check BASE TREE)"
git diff --check "$BASE_OID" "$TREE_OID"

# These two are cheap enough to run unconditionally (~2s combined): keeping
# them global is simpler and safer than maintaining an affected-mapping for
# structural invariants. Both evaluate the snapshot, not the worktree.
step "validate_repo.py --strict"
(cd "$CAND" && "$PY" scripts/validate_repo.py --strict)

step "skill-quality-gate --strict"
"$PY" "$CAND/skills/skill-quality-gate/scripts/quality_report.py" --root "$CAND" --strict

step "python syntax (batched)"
field compile | "$PY" -c '
import compileall, pathlib, sys
root = pathlib.Path(sys.argv[1])
targets = [ln.strip() for ln in sys.stdin if ln.strip()]
bad = [f for f in targets
       if not compileall.compile_file(str(root / f), quiet=2, force=True)]
for f in bad:
    print(f"py_compile FAIL: {f}", file=sys.stderr)
sys.exit(1 if bad else 0)
' "$CAND"

step "repository regression tests"
mapfile -t TESTS < <(field unittest)
if [ "${#TESTS[@]}" -gt 0 ]; then
  MODS=()
  for t in "${TESTS[@]}"; do
    MODS+=("$(echo "$t" | sed 's|/|.|g; s|\.py$||')")
  done
  (cd "$CAND" && "$PY" -m unittest "${MODS[@]}" -q)
else
  echo "no affected unittests — skipped"
fi
mapfile -t SUITES < <(field mcp_suites)
for s in "${SUITES[@]}"; do
  (cd "$CAND" && "$PY" -m unittest discover -s "$s" -q)
done

step "snapshot verify"
[ "$(git rev-parse HEAD)" = "$BASE_OID" ] \
  || fail "HEAD moved during checks — rerun the commit"
[ "$(git write-tree)" = "$TREE_OID" ] \
  || fail "index changed during checks (foreign stage) — rerun the commit"

echo
echo "pre-commit gate: PASS (mode=$MODE tree=${TREE_OID:0:12})"

#!/usr/bin/env bash
# Pre-commit gate for the agent-tooling repository.
#
# Install once per clone:
#   git config core.hooksPath .githooks
#
# Two modes, chosen by scripts/gate_planner.py from the staged diff:
#   DELTA — certified-base reasoning: base commit already passed the full
#           gate, so only what this diff can affect is re-checked.
#   FULL  — gate machinery / shared registries / unknown paths changed:
#           the incremental argument no longer holds, run everything.
# Either way the repo invariants stay identical; only the work differs.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Git exports GIT_INDEX_FILE (relative ".git/index") into hook env; any child
# git process running inside ANOTHER repo/worktree (e.g. the workspace
# isolation tests) resolves it against that repo and fails with
# ".git/index.lock: No such file or directory". Clear repo-scoping vars so
# test/git subprocesses are hermetic.
unset GIT_INDEX_FILE GIT_PREFIX GIT_DIR GIT_WORK_TREE \
  GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES \
  GIT_COMMON_DIR GIT_NAMESPACE 2>/dev/null || true

PY="${PYTHON:-python3}"
"$PY" -c '' >/dev/null 2>&1 || PY=python

step() { printf '\n== %s ==\n' "$1"; }

step "canonical writer ownership"
"$PY" scripts/governance/canonical_writer.py pre-commit

step "impact plan"
"$PY" scripts/gate_planner.py --staged
MODE="$("$PY" scripts/gate_planner.py --staged --field mode)"

step "whitespace check (git diff --check)"
git diff --cached --check
git diff --check

# These two are cheap enough to run unconditionally (~2s combined): keeping
# them global is simpler and safer than maintaining an affected-mapping for
# structural invariants.
step "validate_repo.py --strict"
"$PY" scripts/validate_repo.py --strict

step "skill-quality-gate --strict"
"$PY" skills/skill-quality-gate/scripts/quality_report.py --root . --strict

step "python syntax (batched)"
# One interpreter compiles every target — the old per-file spawn loop cost
# minutes at ~2753 files (Windows process creation dominates py_compile).
if [ "$MODE" = "FULL" ]; then
  "$PY" - <<'PYEOF'
import compileall, pathlib, sys
files = [p for p in pathlib.Path(".").rglob("*.py")
         if "__pycache__" not in p.parts and "node_modules" not in p.parts]
bad = [str(p) for p in files if not compileall.compile_file(str(p), quiet=2, force=True)]
for f in bad:
    print(f"py_compile FAIL: {f}", file=sys.stderr)
sys.exit(1 if bad else 0)
PYEOF
else
  "$PY" scripts/gate_planner.py --staged --field compile | "$PY" -c '
import compileall, pathlib, sys
targets = [ln.strip() for ln in sys.stdin if ln.strip() and ln.strip() != "ALL"]
bad = [f for f in targets
       if pathlib.Path(f).is_file() and not compileall.compile_file(f, quiet=2, force=True)]
for f in bad:
    print(f"py_compile FAIL: {f}", file=sys.stderr)
sys.exit(1 if bad else 0)'
fi

step "repository regression tests"
if [ "$MODE" = "FULL" ]; then
  "$PY" -m unittest discover -s tests -q
else
  mapfile -t TESTS < <("$PY" scripts/gate_planner.py --staged --field unittest)
  if [ "${#TESTS[@]}" -gt 0 ]; then
    MODS=()
    for t in "${TESTS[@]}"; do MODS+=("$(echo "$t" | sed 's|/|.|g; s|\.py$||')"); done
    "$PY" -m unittest "${MODS[@]}" -q
  else
    echo "no affected unittests — skipped"
  fi
  mapfile -t SUITES < <("$PY" scripts/gate_planner.py --staged --field mcp_suites)
  for s in "${SUITES[@]}"; do
    [ "$s" = "ALL" ] && s="mcp/agent-switchboard/tests"
    "$PY" -m unittest discover -s "$s" -q
  done
fi

echo
echo "pre-commit gate: PASS (mode=$MODE)"

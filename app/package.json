{
  "name": "@personal-ai/app",
  "version": "0.1.0",
  "private": true,
  "description": "Personal AI-owned user-facing app: body selection + governed chat over the host channel",
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server/dev.js",
    "start:modern": "node server/dev.js --ui modern",
    "start:desktop": "node desktop/start.js",
    "start:desktop:modern": "node desktop/start.js --ui modern",
    "dev:modern": "vite",
    "build:modern": "vite build",
    "test": "node --import ./tests/scrub-env.mjs --test \"tests/*.test.js\"",
    "lint:css": "stylelint ui/style.css",
    "lint:html": "html-validate ui/index.html",
    "lint:modern": "vite build",
    "lint": "npm run lint:css && npm run lint:html && npm run lint:modern",
    "gate": "npm run lint && npm test"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.13.0",
    "clsx": "^2.1.1",
    "colord": "^2.10.0",
    "electron": "44.3.0",
    "html-validate": "^11.16.0",
    "lucide": "^1.47.0",
    "lucide-react": "^1.57.0",
    "postcss": "^8.5.30",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "write-good": "^1.0.8"
  }
}
